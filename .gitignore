tests/fixtures/**/*.gcno

# Generated mutation reports (local runs)
mutation-reports/
*.mutation-report.json
*.mutation-results.xml
*.mutation-report.html

# dart_mutant cache (content-addressed, local only)
.dart_mutant_cache/

# Environment
.env
.env.local

# Logs
*.log
